rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function checking authentication and verified email
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'arabsafashion@gmail.com'
      );
    }

    // 1. User private storage directory: strictly owned by request.auth.uid and verified
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isVerified() && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }

    // 2. Consulting services images
    match /consulting-services/{serviceId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // 3. Public website assets and media library
    match /{allPaths=**} {
      // Public read for website assets and media library
      allow read: if true;

      // Only administrators with verified email can upload, update, or delete media files
      // Restrict to images under 10MB
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
